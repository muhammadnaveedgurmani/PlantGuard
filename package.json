{
  "name": "plantguard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --d1=plantguard-production --r2=plantguard-images --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name plantguard",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "db:migrate:local": "wrangler d1 migrations apply plantguard-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply plantguard-production",
    "db:console:local": "wrangler d1 execute plantguard-production --local",
    "db:console:prod": "wrangler d1 execute plantguard-production",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "typescript": "^5.6.0",
    "vite": "^8.1.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.110.0"
  }
}
